              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Review": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "advance",
              "hold"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "Review"
      },
      "RubricApproval": {
        "properties": {
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Weights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "weights"
        ],
        "title": "RubricApproval"
      },
      "RunRequest": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "candidate_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Candidate Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "candidate_ids"
        ],
        "title": "RunRequest"
      },
      "Slot": {
        "properties": {
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "timezone"
        ],
        "title": "Slot"
      },
      "SourceApproval": {
        "properties": {
          "sanitized_text": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 20,
            "title": "Sanitized Text"
          },
          "identity_removed": {
            "type": "boolean",
            "const": true,
            "title": "Identity Removed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sanitized_text",
          "identity_removed"
        ],
        "title": "SourceApproval"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
